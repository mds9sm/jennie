# AI Provider: "anthropic" (direct API) or "bedrock" (AWS Bedrock)
AI_PROVIDER=anthropic

# Anthropic direct API (when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your-api-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514

# AWS Bedrock (when AI_PROVIDER=bedrock — uses SSO creds or ~/.aws)
BEDROCK_REGION=us-west-2
BEDROCK_MODEL=us.anthropic.claude-sonnet-4-20250514-v1:0

# Redshift mode: "mock" (no AWS needed) or "real" (requires SSO login)
REDSHIFT_MODE=mock

# Redshift clusters
REDSHIFT_NP_HOST=nonprod-redshift-cluster.css1j4dcotkk.us-west-2.redshift.amazonaws.com
REDSHIFT_NP_PORT=5439
REDSHIFT_NP_DATABASE=dev
REDSHIFT_NP_CLUSTER_ID=nonprod-redshift-cluster

REDSHIFT_PRD_HOST=prod-redshift-cluster.css1j4dcotkk.us-west-2.redshift.amazonaws.com
REDSHIFT_PRD_PORT=5439
REDSHIFT_PRD_DATABASE=dev
REDSHIFT_PRD_CLUSTER_ID=prod-redshift-cluster

# AWS SSO profiles (must match ~/.aws/config)
AWS_PROFILE_NP=nonprod
AWS_PROFILE_PRD=prod
AWS_REGION=us-west-2

# Fallback: explicit user/password (if not using IAM/SSO)
REDSHIFT_NP_USER=
REDSHIFT_NP_PASSWORD=
REDSHIFT_PRD_USER=
REDSHIFT_PRD_PASSWORD=

# Git repo (data platform transforms)
REPO_URL=https://github.com/your-org/data-platform-dags
GITHUB_TOKEN=
REPO_PATH=/app/data-repo

# Postgres (usage tracking) - set by docker-compose
DATABASE_URL=postgresql+asyncpg://genie:genie_local@postgres:5432/genie

# Logging
LOG_LEVEL=INFO
