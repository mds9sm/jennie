FROM python:3.12-slim

WORKDIR /app

# Install only the dependencies Data MCP needs (no KB/catalog/Claude deps)
RUN pip install --no-cache-dir \
    fastapi==0.115.12 \
    uvicorn[standard]==0.34.0 \
    starlette==0.46.1 \
    mcp==1.12.4 \
    redshift_connector==2.1.4 \
    boto3==1.37.29 \
    botocore==1.37.29

COPY data_mcp/ ./data_mcp/

ENV PYTHONPATH=/app
ENV REDSHIFT_MODE=mock

EXPOSE 8000

CMD ["uvicorn", "data_mcp.main:app", "--host", "0.0.0.0", "--port", "8000"]
